# MySQL 连接（本地 docker compose 默认值；生产经部署注入，勿提交真实凭据）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dsh
MYSQL_PASSWORD=dsh_dev_password
MYSQL_DATABASE=dsh_session
MYSQL_TABLE_PREFIX=dsh_

# 自动化测试专用库（vitest 启动时覆盖 MYSQL_DATABASE）。测试隔离用独立库。
MYSQL_TEST_DATABASE=test
# root 密码：仅供测试启动时引导测试库（建库+授权），插件本身不用。
MYSQL_ROOT_PASSWORD=root_dev_password

# 读写分离读库：留空则复用写库连接（测试同库即此模式）
MYSQL_READ_HOST=
MYSQL_READ_USER=
MYSQL_READ_PASSWORD=

# TLS（暂缓，保留配置位；届时可能由云服务商提供）
MYSQL_SSL_REQUIRED=false

# 可选应用层字段加密 key（base64）。本轮默认空 = 明文存储。
ENCRYPTION_KEY=
