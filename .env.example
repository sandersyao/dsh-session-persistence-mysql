# MySQL 连接（本地 docker compose 默认值；生产经部署注入，勿提交真实凭据）
# 本插件独享 SESSION_* 优先；缺省回退共享 MYSQL_*（可与 storage/credentials 同库共存）。
SESSION_HOST=127.0.0.1
SESSION_PORT=3306
SESSION_USER=dsh
SESSION_PASSWORD=
SESSION_DATABASE=dsh_session
SESSION_TABLE_PREFIX=dsh_

# 自动化测试专用库（vitest 启动时覆盖 SESSION_DATABASE）。测试隔离用独立库。
SESSION_TEST_DATABASE=test
# root 密码：仅供测试启动时引导测试库（建库+授权），插件本身不用。
MYSQL_ROOT_PASSWORD=root_dev_password

# 读写分离读库：留空则复用写库连接（测试同库即此模式）
SESSION_READ_HOST=
SESSION_READ_USER=
SESSION_READ_PASSWORD=

# schema 自动迁移：true=启动幂等建表+版本校验；false=只校验
SESSION_SCHEMA_AUTO_MIGRATE=true

# TLS（暂缓，保留配置位；届时可能由云服务商提供）
SESSION_SSL_REQUIRED=false

# 可选应用层字段加密 key（base64）。本轮默认空 = 明文存储。
SESSION_ENCRYPTION_KEY=

# 连接池 / 持久化语义（可选，缺省回退 MYSQL_* 同名）
SESSION_POOL_SIZE=10
SESSION_POOL_QUEUE_LIMIT=0
SESSION_WRITE_BATCH_DELAY_MS=200
SESSION_PREPARED_CACHE_SIZE=5
SESSION_PACK_CHUNKS=true
